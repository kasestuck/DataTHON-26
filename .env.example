API_KEY=replace-with-a-long-random-secret
ANALYZER_TARGET=backend.analyzer:analyze_video
DATA_DIR=var
CATALOG_DIR=backend/data
# Set to the tunnel's HTTPS origin when the public address is known.
PUBLIC_ORIGIN=
# Public frontend only; never set this to the repository root.
FRONTEND_DIST=frontend
# Same-origin frontend needs no CORS. Comma-separated explicit origins only.
CORS_ORIGINS=
